{
  "name": "urban-style-tailwind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "build": "tailwindcss -i ./src/input.css -o ./assets/styles.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
    "lint:html": "html-validate \"./index.html\"",
    "lint:quality": "node scripts/quality-check.mjs",
    "ci": "node scripts/ci-check.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "axe-core": "^4.13.0",
    "html-validate": "^8.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.0"
  }
}
